{
  "name": "zyt",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build --mode production",
    "watch": "vite build --watch --mode development",
    "build-site": "npm run build && cp dist/* zyt.alexi.ch-site/",
    "build-site-docker": "docker build -t registry.alexi.ch/zyt.alexi.ch -f Dockerfile-zyt.alexi.ch ."
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "query-string": "^9.1.1",
    "vite": "^5.4.9"
  }
}
